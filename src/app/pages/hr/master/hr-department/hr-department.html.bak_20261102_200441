<p-toast position="top-right" [baseZIndex]="10000"></p-toast>

<div class="department-page">

    <div style="margin-bottom: 1rem;">
        <p-button
            label="Test Toast"
            icon="pi pi-bell"
            severity="warn"
            (onClick)="testToast()"
        />
    </div>
    <div class="page-header">
        <div>
            <h2 class="page-title">Department</h2>
            <div class="page-subtitle">
                Manage departments and organizational information.
            </div>
        </div>

        <div class="page-actions">
            @if (access.canCreate) {
                <p-button
                    label="New Department"
                    icon="pi pi-plus"
                    (onClick)="openNew()"
                />
            }

            <p-button
                label="Refresh"
                icon="pi pi-refresh"
                severity="secondary"
                [outlined]="true"
                (onClick)="refresh()"
            />

            @if (access.canView) {
                <app-excel-export-button
                    endpoint="hrdepartment/export"
                    fileName="HR_Department"
                    [search]="search"
                    [sortField]="sortField"
                    [sortDirection]="sortDirection"
                />
            }
        </div>
    </div>

    <div class="toolbar-row">

        <div class="search-area">

            <div class="search-box">
                <i class="pi pi-search"></i>

                <input
                    pInputText
                    type="text"
                    [(ngModel)]="search"
                    maxlength="250"
                    placeholder="Search department code or name..."
                    (keyup.enter)="searchDepartments()"
                />

                @if (search) {
                    <button
                        type="button"
                        class="clear-search"
                        aria-label="Clear search"
                        (click)="clearSearch()"
                    >
                        <i class="pi pi-times"></i>
                    </button>
                }
            </div>

            <p-button
                label="Search"
                icon="pi pi-search"
                [outlined]="true"
                (onClick)="searchDepartments()"
            />
        </div>

        <div class="result-summary">
            {{ totalRecords }}
            result{{ totalRecords === 1 ? '' : 's' }}
        </div>

    </div>

    <div class="table-card">
        <p-table
            [value]="departments"
            [loading]="loading"
            [paginator]="true"
            [lazy]="true"
            (onLazyLoad)="onLazyLoad($event)"
            [rows]="pageSize"
            [first]="first"
            [totalRecords]="totalRecords"
            [rowsPerPageOptions]="[10, 20, 50, 100]"
            [rowHover]="true"
            [showGridlines]="true"
            dataKey="departmentId"
            [showCurrentPageReport]="true"
            currentPageReportTemplate="Showing {first} to {last} of {totalRecords} departments"
            [sortField]="sortField"
            [sortOrder]="sortDirection === 'asc' ? 1 : -1"
            [tableStyle]="{ 'min-width': '65rem' }"
        >

            <ng-template #header>
                <tr>
                    <th pSortableColumn="departmentCode">
                        Department Code
                        <p-sortIcon field="departmentCode" />
                    </th>

                    <th pSortableColumn="departmentName">
                        Department Name
                        <p-sortIcon field="departmentName" />
                    </th>

                    <th pSortableColumn="seqNo">
                        Sequence No
                        <p-sortIcon field="seqNo" />
                    </th>

                    <th>Note</th>
                    <th>Created At</th>
                    <th>Created By</th>
                    <th>Edited At</th>
                    <th>Edited By</th>

                    @if (access.canUpdate) {
                        <th class="text-center" style="width: 9rem">
                            Action
                        </th>
                    }
                </tr>
            </ng-template>

            <ng-template #body let-department>
                <tr>
                    <td class="font-semibold">
                        {{ department.departmentCode }}
                    </td>

                    <td>
                        {{ department.departmentName }}
                    </td>

                    <td>
                        {{ department.seqNo ?? '-' }}
                    </td>

                    <td>
                        {{ department.note || '-' }}
                    </td>

                    <td>
                        {{ department.createdAt
                            ? (department.createdAt | date:'dd/MM/yyyy HH:mm')
                            : '-' }}
                    </td>

                    <td>
                        {{ department.createdBy ?? '-' }}
                    </td>

                    <td>
                        {{ department.editedAt
                            ? (department.editedAt | date:'dd/MM/yyyy HH:mm')
                            : '-' }}
                    </td>

                    <td>
                        {{ department.editedBy ?? '-' }}
                    </td>

                    @if (access.canUpdate) {
                        <td>
                            <div class="row-actions">
                                <p-button
                                    icon="pi pi-pencil"
                                    label="Edit"
                                    severity="success"
                                    [rounded]="true"
                                    [text]="true"
                                    size="small"
                                    (onClick)="editDepartment(department)"
                                />
                            </div>
                        </td>
                    }
                </tr>
            </ng-template>

            <ng-template #emptymessage>
                <tr>
                    <td [attr.colspan]="access.canUpdate ? 9 : 8">
                        <div class="empty-state">
                            <i class="pi pi-sitemap"></i>

                            <div class="empty-title">
                                No departments found
                            </div>

                            <div class="empty-description">
                                Create a department or change your search criteria.
                            </div>
                        </div>
                    </td>
                </tr>
            </ng-template>

        </p-table>
    </div>

</div>

<p-dialog
    [(visible)]="dialogVisible"
    [modal]="true"
    [draggable]="false"
    [resizable]="false"
    [closable]="!saving"
    [closeOnEscape]="!saving"
    [style]="{ width: '800px', maxWidth: '95vw' }"
    [header]="editing ? 'Edit Department' : 'New Department'"
>

    <div class="dialog-content">

        <div class="dialog-section">
            <div class="section-title">
                <i class="pi pi-info-circle"></i>
                Basic Information
            </div>

            <div class="form-grid">

                <div class="field-block">
                    <label for="departmentCode">
                        Department Code
                        <span class="required">*</span>
                    </label>

                    <input
                        id="departmentCode"
                        pInputText
                        [(ngModel)]="form.departmentCode"
                        maxlength="50"
                        autocomplete="off"
                        placeholder="e.g. HR"
                        [disabled]="saving"
                    />

                    @if (submitted && !form.departmentCode.trim()) {
                        <small class="field-error">
                            Department Code is required.
                        </small>
                    }

                    <small class="field-help">
                        Unique department code within the company.
                    </small>
                </div>

                <div class="field-block">
                    <label for="departmentName">
                        Department Name
                        <span class="required">*</span>
                    </label>

                    <input
                        id="departmentName"
                        pInputText
                        [(ngModel)]="form.departmentName"
                        maxlength="250"
                        autocomplete="off"
                        placeholder="Department name"
                        [disabled]="saving"
                    />

                    @if (submitted && !form.departmentName.trim()) {
                        <small class="field-error">
                            Department Name is required.
                        </small>
                    }
                </div>

                <div class="field-block">
                    <label for="seqNo">
                        Sequence Number
                    </label>

                    <p-inputNumber
                        inputId="seqNo"
                        [(ngModel)]="form.seqNo"
                        [useGrouping]="false"
                        [minFractionDigits]="0"
                        [maxFractionDigits]="0"
                        [min]="-2147483648"
                        [max]="2147483647"
                        [disabled]="saving"
                    />

                    <small class="field-help">
                        Optional display order.
                    </small>
                </div>

            </div>
        </div>

        <div class="dialog-section">
            <div class="section-title">
                <i class="pi pi-file-edit"></i>
                Additional Information
            </div>

            <div class="field-block">
                <label for="departmentNote">
                    Note
                </label>

                <textarea
                    id="departmentNote"
                    class="note-input"
                    [(ngModel)]="form.note"
                    maxlength="250"
                    rows="3"
                    placeholder="Optional note..."
                    [disabled]="saving"
                ></textarea>

                <small class="field-help">
                    Maximum 250 characters.
                </small>
            </div>
        </div>

    </div>

    <ng-template #footer>
        <p-button
            label="Cancel"
            icon="pi pi-times"
            severity="secondary"
            [outlined]="true"
            [disabled]="saving"
            (onClick)="hideDialog()"
        />

        <p-button
            [label]="editing ? 'Save' : 'Create'"
            icon="pi pi-check"
            [loading]="saving"
            [disabled]="saving"
            (onClick)="saveDepartment()"
        />
    </ng-template>

</p-dialog>


